{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/assets/favicon.ico", "destination": "/favicon.ico", "permanent": true },
    { "source": "/assets/logo/favicon.svg", "destination": "/favicon.svg", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/soluciones/:page",
      "destination": "/soluciones/:page.html"
    },
    {
      "source": "/industrias/:page",
      "destination": "/industrias/:page.html"
    },
    {
      "source": "/guias/:page",
      "destination": "/guias/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|apple-touch-icon.png|icon-192.png|icon-512.png|icon-maskable-512.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(img|og)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
